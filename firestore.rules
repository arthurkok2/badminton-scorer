rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidRoomCode(code) {
      return code is string
        && code.size() == 4
        && code.matches('^[A-HJ-NP-Z2-9]{4}$');
    }

    function isValidMatchMode(mode) {
      return mode is string && mode in ['singles', 'doubles'];
    }

    function isValidTeamId(v) {
      return v is string && v in ['teamA', 'teamB'];
    }

    function isValidCommandType(t) {
      return t is string && t in ['POINT_TEAM', 'UNDO', 'ANNOUNCE'];
    }

    function isValidSourceKind(k) {
      return k is string && k in ['wear', 'web'];
    }

    function isNamedSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isValidPlayerId(v) {
      return v is string && v.size() >= 1 && v.size() <= 128;
    }

    function isValidPlayerList(v) {
      return v is list && v.size() == 2 && isValidPlayerId(v[0]) && isValidPlayerId(v[1]);
    }

    function isValidElo(v) {
      return v is number && v >= 0 && v <= 5000;
    }

    function matchDocKeys() {
      return ['active', 'code', 'createdAt', 'hostHeartbeatAt', 'hostId',
              'matchMode', 'matchState', 'updatedAt', 'winnerTeamId',
              'lastAppliedCommandId'];
    }

    function playerDocKeys() {
      return ['id', 'displayName', 'searchName', 'createdBy', 'createdAt',
              'updatedAt', 'claimStatus', 'linkedUid', 'globalIndividualElo',
              'globalMatchCount', 'statsVersion', 'spriteId'];
    }

    function isValidSpriteId(v) {
      return v is string && v in [
        'female-ace', 'female-drop', 'female-drive', 'female-net',
        'male-clear', 'male-defense', 'male-jump-smash', 'male-serve'
      ];
    }

    function pairDocKeys() {
      return ['id', 'playerIds', 'displayNames', 'createdAt', 'updatedAt',
              'globalPairElo', 'globalMatchCount', 'statsVersion'];
    }

    function globalMatchDocKeys() {
      return ['id', 'submittedBy', 'sessionId', 'sourcePath', 'matchNumber',
              'teamAPlayerIds', 'teamBPlayerIds', 'teamAPairId', 'teamBPairId',
              'winnerTeam', 'finalScore', 'startedAt', 'endedAt',
              'globalIndividualElo', 'globalPairElo', 'status', 'createdAt'];
    }

    match /matches/{code} {
      allow read: if true;

      allow create: if
        isNamedSignedIn()
        && request.auth.uid == request.resource.data.hostId
        && isValidRoomCode(code)
        && request.resource.data.code == code
        && request.resource.data.active == true
        && request.resource.data.hostId is string
        && request.resource.data.hostId.size() >= 1
        && request.resource.data.hostId.size() <= 128
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.hostHeartbeatAt == request.time
        && isValidMatchMode(request.resource.data.matchMode)
        && request.resource.data.matchState is map
        && (
          !('winnerTeamId' in request.resource.data)
          || isValidTeamId(request.resource.data.winnerTeamId)
        )
        && request.resource.data.keys().hasOnly(matchDocKeys());

      allow update: if
        isNamedSignedIn()
        && request.auth.uid == resource.data.hostId
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.hostHeartbeatAt == request.time
        && isValidMatchMode(request.resource.data.matchMode)
        && request.resource.data.matchState is map
        && (
          !('winnerTeamId' in request.resource.data)
          || isValidTeamId(request.resource.data.winnerTeamId)
        )
        && request.resource.data.keys().hasOnly(matchDocKeys());

      allow delete: if false;

      match /commands/{commandId} {
        allow read: if true;

        allow create: if
          isNamedSignedIn()
          && isValidCommandType(request.resource.data.type)
          && isValidSourceKind(request.resource.data.sourceKind)
          && request.resource.data.sourceId is string
          && request.resource.data.sourceId.size() >= 1
          && request.resource.data.sourceId.size() <= 128
          && request.resource.data.createdAt == request.time
          && !('appliedAt' in request.resource.data)
          && !('rejectedAt' in request.resource.data)
          && !('rejectionReason' in request.resource.data)
          && (
            request.resource.data.type != 'POINT_TEAM'
            || isValidTeamId(request.resource.data.teamId)
          )
          && (
            request.resource.data.type == 'POINT_TEAM'
            || !('teamId' in request.resource.data)
          )
          && request.resource.data.keys().hasOnly(
            ['type', 'teamId', 'sourceId', 'sourceKind', 'createdAt']
          );

        allow update: if
          isNamedSignedIn()
          && request.auth.uid == get(/databases/$(database)/documents/matches/$(code)).data.hostId
          && resource.data.type == request.resource.data.type
          && resource.data.sourceId == request.resource.data.sourceId
          && resource.data.sourceKind == request.resource.data.sourceKind
          && resource.data.createdAt == request.resource.data.createdAt
          && (
            !('teamId' in resource.data)
            || resource.data.teamId == request.resource.data.teamId
          )
          && (
            !('rejectionReason' in request.resource.data)
            || (
              request.resource.data.rejectionReason is string
              && request.resource.data.rejectionReason.size() <= 256
            )
          )
          && request.resource.data.keys().hasOnly(
            ['type', 'teamId', 'sourceId', 'sourceKind', 'createdAt',
             'appliedAt', 'rejectedAt', 'rejectionReason']
          );

        allow delete: if false;
      }
    }

    match /players/{playerId} {
      allow read: if isNamedSignedIn();
      allow create: if isNamedSignedIn()
        && request.resource.data.id == playerId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.searchName is string
        && request.resource.data.searchName.size() >= 1
        && request.resource.data.searchName.size() <= 80
        && request.resource.data.claimStatus == 'guest'
        && request.resource.data.globalIndividualElo == 1500
        && request.resource.data.globalMatchCount == 0
        && request.resource.data.statsVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          !('spriteId' in request.resource.data)
          || isValidSpriteId(request.resource.data.spriteId)
        )
        && request.resource.data.keys().hasOnly(playerDocKeys());
      allow update: if isNamedSignedIn()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.searchName == resource.data.searchName
        && request.resource.data.claimStatus == resource.data.claimStatus
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidElo(request.resource.data.globalIndividualElo)
        && request.resource.data.globalMatchCount is number
        && request.resource.data.globalMatchCount >= resource.data.globalMatchCount
        && (
          !('spriteId' in request.resource.data)
          || isValidSpriteId(request.resource.data.spriteId)
        )
        && request.resource.data.keys().hasOnly(playerDocKeys());
      allow delete: if false;
    }

    match /pairs/{pairId} {
      allow read: if isNamedSignedIn();
      allow create: if isNamedSignedIn()
        && request.resource.data.id == pairId
        && isValidPlayerList(request.resource.data.playerIds)
        && request.resource.data.displayNames is list
        && request.resource.data.displayNames.size() == 2
        && isValidElo(request.resource.data.globalPairElo)
        && request.resource.data.globalMatchCount is number
        && request.resource.data.globalMatchCount >= 0
        && request.resource.data.statsVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(pairDocKeys());
      allow update: if isNamedSignedIn()
        && request.resource.data.id == resource.data.id
        && request.resource.data.playerIds == resource.data.playerIds
        && request.resource.data.displayNames == resource.data.displayNames
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidElo(request.resource.data.globalPairElo)
        && request.resource.data.globalMatchCount is number
        && request.resource.data.globalMatchCount >= resource.data.globalMatchCount
        && request.resource.data.keys().hasOnly(pairDocKeys());
      allow delete: if false;
    }

    match /globalMatches/{matchId} {
      allow read: if isNamedSignedIn();
      allow create: if isNamedSignedIn()
        && request.resource.data.id == matchId
        && request.resource.data.submittedBy == request.auth.uid
        && isValidPlayerList(request.resource.data.teamAPlayerIds)
        && isValidPlayerList(request.resource.data.teamBPlayerIds)
        && isValidTeamId(request.resource.data.winnerTeam)
        && request.resource.data.sourcePath is string
        && request.resource.data.sourcePath.matches('^users/' + request.auth.uid + '/sessions/[^/]+/matches/[^/]+$')
        && request.resource.data.matchNumber is number
        && request.resource.data.teamAPairId is string
        && request.resource.data.teamBPairId is string
        && request.resource.data.globalIndividualElo is map
        && request.resource.data.globalPairElo is map
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(globalMatchDocKeys());
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read, create, update: if isNamedSignedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /sessions/{sessionId} {
        allow read, create, update: if isNamedSignedIn() && request.auth.uid == userId;
        allow delete: if false;

        match /matches/{matchId} {
          allow read, create: if isNamedSignedIn() && request.auth.uid == userId;
          allow update, delete: if false;
        }
      }

      match /stats/{statsId} {
        allow read, create, update: if isNamedSignedIn() && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
