    entry="GarminRemoteApp"
    id="a3b4c5d6-e7f8-1234-abcd-badminton0001"
    launcherIcon="@Drawables.LauncherIcon"
    minSdkVersion="3.2.0"
    name="@Strings.AppName"
    type="watch-app"
    version="1.0.0">

    <!-- Forerunner 265 -->
    <iq:products>
      <iq:product id="fr265"/>
      <iq:product id="fr265s"/>
